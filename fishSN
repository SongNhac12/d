local runningBobaAshen = false

--=====================================================
--  AUTO CRAFT
--=====================================================
local function doCraft()
    if not _G.AutoCraft then return end

    local args = { "TimeJumper", "gear" }
    ReplicatedStorage.rbxts_include.node_modules["@rbxts"].remo.src.container["crafting.selectCraftingItem"]:FireServer(unpack(args))

    task.wait(0.5)

    local args2 = {
        { "TeleportWand", "MagnifyingGlass", "AdvancedAutoFeeder" },
        "gear"
    }
    ReplicatedStorage.rbxts_include.node_modules["@rbxts"].remo.src.container["crafting.submitItems"]:FireServer(unpack(args2))

    task.wait(0.5)

    local args3 = { "gear" }
    ReplicatedStorage.rbxts_include.node_modules["@rbxts"].remo.src.container["crafting.startCraft"]:FireServer(unpack(args3))

    for i = 1, 600 do
        if not _G.AutoCraft then return end
        task.wait(1)
    end

    local args4 = { "gear" }
    ReplicatedStorage.rbxts_include.node_modules["@rbxts"].remo.src.container["crafting.collectCraft"]:FireServer(unpack(args4))
end

--=====================================================
--  THREAD LOOPS
--=====================================================
-- Auto Shop + Auto Egg
task.spawn(function()
    while true do
        if _G.AutoShop then
            if _G.AutoBait then
                purchaseEventItem:FireServer(unpack(argsBait))
            end

            purchaseGear:FireServer(unpack(argsFood))
            purchaseGear:FireServer(unpack(argsFeeder))

            for _, item in ipairs(AutoItems) do
                purchaseGear:FireServer(unpack(item))
            end

            if _G.AutoEgg then
                purchaseEgg:FireServer(unpack(argsEggTropical))
                purchaseEgg:FireServer(unpack(argsEggEtoxic))
            end
        end
        task.wait(1)
    end
end)

-- Auto Craft
task.spawn(function()
    while true do
        if _G.AutoCraft then
            doCraft()
        end
        task.wait(1)
    end
end)

-- Auto Boba & Ashen
task.spawn(function()
    while true do
        if runningBobaAshen then
            local Rep = game:GetService("ReplicatedStorage")
            local remote = Rep.rbxts_include.node_modules["@rbxts"].remo.src.container["merchant.purchaseItem"]

            local function fire(typeName)
                remote:FireServer({[1]="travelling",[2]=typeName})
            end

            fire("Boba")
            fire("Ashen")
        end
        task.wait(1)
    end
end)

--=====================================================
--  SIMPLE DRAGGABLE UI
--=====================================================
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local Frame = Instance.new("Frame", ScreenGui)
local UICorner = Instance.new("UICorner", Frame)

Frame.Size = UDim2.new(0, 200, 0, 260)
Frame.Position = UDim2.new(0.05, 0, 0.3, 0)
Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)

local dragToggle, dragStart, startPos
Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragToggle = true
        dragStart = input.Position
        startPos = Frame.Position
    end
end)
Frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragToggle = false
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragToggle and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

--=====================================================
--  BUTTONS
--=====================================================
local function createBtn(text, order)
    local btn = Instance.new("TextButton", Frame)
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.Position = UDim2.new(0, 10, 0, 10 + (order - 1) * 45)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 16
    btn.Text = text
    Instance.new("UICorner", btn)
    return btn
end

