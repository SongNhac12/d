----------------------
-- 2. AUTO FARM CHEST
----------------------
local FLY_SPEED = 250
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local TweenService = game:GetService("TweenService")
local ChestFolder = workspace:WaitForChild("ChestModels")

local visitedPositions = {}

local function posToKey(v3)
    return string.format("%.1f_%.1f_%.1f", v3.X, v3.Y, v3.Z)
end

local isFlying = false
local currentTween

-- LẤY PRIMARYPART AN TOÀN
local function getPrimary(chest)
    for i = 1, 10 do
        local p = chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart")
        if p then return p end
        task.wait(0.05)
    end
    return nil
end

-- TÌM CHEST GẦN NHẤT
local function getNearestChest()
    if _G.IsTeleporting then return nil end

    local nearest, shortest = nil, math.huge
    for _, chest in ipairs(ChestFolder:GetChildren()) do
        if chest:IsA("Model") then
            local p = getPrimary(chest)
            if p then
                local key = posToKey(p.Position)
                if not visitedPositions[key] then
                    local dist = (p.Position - root.Position).Magnitude
                    if dist < shortest then
                        shortest = dist
                        nearest = chest
                    end
                end
            end
        end
    end
    return nearest
end

-- BAY ĐẾN CHEST
local function flyTo(part)
    if _G.IsTeleporting then return end
    if currentTween then currentTween:Cancel() end

    isFlying = true
    local dist = (part.Position - root.Position).Magnitude
    local time = dist / FLY_SPEED

    currentTween = TweenService:Create(
        root,
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(part.Position) }
    )

    currentTween:Play()
    currentTween.Completed:Wait()
    isFlying = false
end

-- LOOP FARM
task.spawn(function()
    while task.wait(0.15) do
        if _G.IsTeleporting or isFlying then continue end

        local chest = getNearestChest()
        if chest then
            local p = getPrimary(chest)
            if p then
                visitedPositions[posToKey(p.Position)] = true
                flyTo(p)
            end
        end
    end
end)

-- AUTO JUMP
task.spawn(function()
