-- 3. AUTO HOP KHI HẾT CHEST
-----------------------------
local TeleportService = game:GetService("TeleportService")
local PLACE_ID = 4442272183
local uniqueSeed = math.floor(tick()*1000) + math.random(1,999999)

task.spawn(function()
    while task.wait(5) do
        if _G.IsTeleporting then return end

        if #ChestFolder:GetChildren() == 0 then
            print("🚀 Hết chest → hop server")

            _G.IsTeleporting = true
            if currentTween then currentTween:Cancel() end

            task.wait(2) -- cho script dừng hẳn
            TeleportService:Teleport(PLACE_ID, player, uniqueSeed)
            return -- RẤT QUAN TRỌNG: dừng script cũ
        end
    end
end)
