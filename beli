local lastChestCount = #ChestFolder:GetChildren()

task.spawn(function()
    while task.wait(1) do
        local currentCount = #ChestFolder:GetChildren()

        if currentCount > lastChestCount then
            print("✔ Chest mới spawn → reset visited list")
            visitedPositions = {}  -- Reset để farm lại tất cả
        end

        lastChestCount = currentCount
    end
end)

