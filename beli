        if _G.IsTeleporting then continue end
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-------------------------------------------
-- RESET VISITED KHI CHEST SPAWN LẠI
-------------------------------------------
local lastChestCount = #ChestFolder:GetChildren()
task.spawn(function()
    while task.wait(1) do
        if _G.IsTeleporting then continue end
        local current = #ChestFolder:GetChildren()
        if current > lastChestCount then
            visitedPositions = {}
        end
        lastChestCount = current
    end
end)

